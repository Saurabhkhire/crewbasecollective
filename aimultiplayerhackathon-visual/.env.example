# Copy to .env (local preview only; .env is git-ignored). On Vercel, set these in the project's Environment Variables.
OPENAI_API_KEY=sk-...
# Any chat model your key can use, e.g. gpt-4.1-mini, gpt-4o-mini, gpt-5-mini
OPENAI_MODEL=gpt-4.1-mini
# Hostnames allowed to call the AI endpoint (comma separated)
AIMP_ALLOWED_ORIGINS=crewbasecollective.com,localhost,127.0.0.1
