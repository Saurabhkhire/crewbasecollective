{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/aimultiplayerhackathon-visual/api/chat", "destination": "/api/aimultiplayer-chat" },
    { "source": "/aimultiplayerhackathon-visual", "destination": "/aimultiplayerhackathon-visual/index.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "{server/**,client/public/data/**,data/**}"
    },
    "api/aimultiplayer-chat.mjs": {
      "maxDuration": 30,
      "includeFiles": "aimultiplayerhackathon-visual/api/**"
    }
  }
}
