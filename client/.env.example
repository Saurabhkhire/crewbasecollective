# AI Multiplayer Hackathon playground (/aim-hack-visual) - local keys
# Copy this file to client/.env.local (git-ignored) and fill in what you have.
# On the live site, add the same names in Vercel -> Project -> Settings -> Environment Variables.
# Visitors choose OpenAI or AdaL in the playground itself; only providers with keys here can be picked.

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1-mini

# --- AdaL Cloud Agents (https://cloud.adal.sylph.ai -> API tab) ---
ADAL_API_KEY=
ADAL_AGENT_ID=
# ADAL_MODEL=
# ADAL_API_URL=https://cloud.adal.sylph.ai
# ADAL_TIMEOUT_MS=40000

# --- Optional ---
# AIMP_IMAGES=off
# AIMP_ALLOWED_ORIGINS=crewbasecollective.com,localhost,127.0.0.1
