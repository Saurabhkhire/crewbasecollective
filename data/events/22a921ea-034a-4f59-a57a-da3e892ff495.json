  "tracks": [
    {
      "id": "bce9960b-f6d3-4ad6-8763-8a1fd98e5b3e",
      "name": "AI SaaS Startup (B2B Tools)",
      "description": "​Build an AI software company that solves a clear business problem. Your product should help companies save time, reduce costs, or improve decision-making.  ​Examples:  ​AI sales assistant that writes follow-up emails and tracks leads  ​HR AI that screens resumes and ranks candidates  ​Finance AI that analyzes expenses and explains trends  ​AI support agent that resolves customer tickets automatically",
      "sortOrder": 0
    },
    {
      "id": "c843701f-a983-40b9-b832-c2346cc6a0b3",
      "name": "AI Consumer Startup (Everyday Apps)",
      "description": "​Create an AI-powered app for everyday users. Focus on personal productivity, lifestyle, learning, or entertainment.  ​Examples:  ​AI study coach that turns notes into quizzes and revision plans  ​AI fitness planner that creates workouts and meal routines  ​AI dating coach that improves profiles and messages  ​AI personal planner that schedules your day based on goals",
      "sortOrder": 0
    },
    {
      "id": "6b675679-b845-4a41-8f9f-7f3763589736",
      "name": "AI Agent Company (Autonomous Workers)",
      "description": "​Build AI agents that can complete tasks end-to-end. These are not chatbots—they are “AI employees” that take goals and execute workflows.  ​Examples:  ​AI marketing agent that creates and schedules social media campaigns  ​AI research agent that reads articles and writes summaries  ​AI recruiter agent that finds candidates and books interviews  ​AI travel agent that plans full trips based on preferences",
      "sortOrder": 0
    },
    {
      "id": "ff58a32d-0467-419e-8f63-472e7658eaac",
      "name": "Vertical AI Company (Industry Specialists)",
      "description": "Focus on one industry and build a highly specialized AI product for it. Go deep instead of broad.  ​Examples:  ​AI lawyer assistant that reviews contracts and finds risks  ​AI healthcare assistant that summarizes patient reports  ​AI real estate assistant that analyzes properties and generates listings",
      "sortOrder": 0
    },
    {
      "id": "cce454c5-4358-4fbb-9f4e-da1700bc2430",
      "name": "AI Creative Studio (Content & Media Company)",
      "description": "​Build an AI company that generates or enhances creative content. This is the “AI entertainment studio” track.  ​Examples:  ​AI film generator that creates short movies from prompts  ​AI music studio that composes songs based on mood  ​AI game content generator that builds characters and storylines  ​AI influencer tool that creates social media posts and videos",
      "sortOrder": 0
    },
    {
      "id": "b75fba3d-8479-4f01-99b4-13831aa01946",
      "name": "Choose Your Own AI Company",
      "description": "​Build any AI startup idea that doesn’t fit into the above tracks. This is for the most experimental, bold, or unconventional ideas.  ​Examples:  ​AI marketplace where users hire AI agents for different tasks  ​AI startup simulator that runs a company autonomously  ​AI negotiation agent that helps users close deals  ​AI life operating system that manages everything from emails to goals",
      "sortOrder": 0
    }
  ],
