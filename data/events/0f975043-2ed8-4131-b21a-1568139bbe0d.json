  "tracks": [
    {
      "id": "0e7f5298-cb7b-4e67-bee3-b9f134685f9a",
      "name": "Sports Arena",
      "description": "​Build tools that change how people play, watch, train, or experience sports.  ​This track is for sports tech, fitness, fan engagement, fantasy sports, live match experiences, analytics, and training products.  ​Example spells:  ​Live match companion app with real-time stats and predictions  ​AI-powered personal fitness coach  ​Fantasy sports platform with social features  ​Fan engagement tool for major sporting events",
      "sortOrder": 0
    },
    {
      "id": "a7ad1f77-f11d-4963-b64e-7f3a29a8429b",
      "name": "Creative Expressions",
      "description": "Build products for music, storytelling, writing, art, and creative collaboration.  ​This track is for builders who want to use technology to help people create, remix, share, and experience stories or media in new ways.  ​Example spells:  ​Interactive AI story generator with branching plots  ​Music composition tool based on mood or prompts  ​Collaborative platform for writers, musicians, or creators  ​Personalized storytelling experience powered by user input",
      "sortOrder": 0
    },
    {
      "id": "5b340afd-c9a9-4ac2-a38c-10cd6307c22f",
      "name": "Potion Lab",
      "description": "Build products focused on personalization, identity, communication, and human connection.  ​This track is for apps that adapt to users, improve social experiences, or create more meaningful digital interactions between people.  ​Example spells:  ​Personalized matchmaking or dating app  ​Smart social network based on interests and personality  ​AI assistant that adapts to a user’s communication style  ​Recommendation engine for communities, events, or creators",
      "sortOrder": 0
    },
    {
      "id": "50c68f9b-bf08-4532-9e27-5961aaee952b",
      "name": "Gamecraft Arena",
      "description": "Build games, playful products, or gamified experiences for real-world use cases.  ​This track is for teams using game mechanics to make learning, productivity, fitness, social interaction, or daily habits more fun and engaging.  ​Example spells:  ​Puzzle game that improves memory or logic skills  ​Gamified habit tracker with rewards and levels  ​Educational game for learning new skills  ​Interactive challenge platform for teams or communities",
      "sortOrder": 0
    }
  ],
