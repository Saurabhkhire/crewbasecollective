# ── Production (Vercel API) ──────────────────────────────────────────────────
# Supabase project — subscribers table only (see supabase/schema.sql)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email — request forms send details to NOTIFY_EMAIL (not stored in Supabase).
# Same fields as CMS Settings. Host/port are filled from the selected provider:
#   gmail → smtp.gmail.com:587
#   brevo → smtp-relay.brevo.com:587
# Local CMS: Settings in data/settings.json win; these env vars fill empty fields
# and are what Vercel /api/requests uses in production.
SMTP_PROVIDER=gmail

# Gmail — GMAIL_SMTP_USER + GMAIL_SMTP_PASS
#   Google Account → Security → 2-Step Verification → App passwords
GMAIL_SMTP_USER=your-email@gmail.com
GMAIL_SMTP_PASS=your-gmail-app-password

# Brevo — BREVO_SMTP_USER + BREVO_SMTP_KEY (SMTP & API page, not the REST API key)
#   Verify the From address as a sender in Brevo before sending.
#   SMTP login is often a generated address, not events@yourdomain.com.
BREVO_SMTP_USER=
BREVO_SMTP_KEY=

# Shared From + inbox for request-form notifications
SMTP_FROM=Crewbase Collective <events@crewbasecollective.com>
NOTIFY_EMAIL=hello@crewbasecollective.com

# Optional aliases for the *active* provider only (if GMAIL_* / BREVO_* are empty)
# SMTP_USER=
# SMTP_PASS=

PORT=4000

# ── One-time export / cleanup from old Supabase Postgres ─────────────────────
# DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
# Encode @ in password as %40. Then: npm run export:data
# After verifying static files: npm run cleanup:supabase
